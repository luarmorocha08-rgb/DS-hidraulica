# ---------------------------------------------------------------
# DS Hidráulica — variáveis de ambiente
# Copie para .env (desenvolvimento) e configure no provedor (produção).
# ---------------------------------------------------------------

# PostgreSQL (Neon, Supabase ou local). Neon/Supabase: inclua ?sslmode=require
DATABASE_URL=postgres://ds:ds@localhost:5432/ds_hidraulica
DATABASE_POOL_MAX=5

# URL pública do site (usada em SEO, links de e-mail e sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo da sessão do painel (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Primeiro administrador (usado por `npm run admin:create` se não passar argumentos)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Anexos de clientes. "local" grava em STORAGE_DIR (fora de /public).
# Em hospedagem serverless (Vercel) use um armazenamento persistente (S3/R2) —
# veja docs/DEPLOY.md.
STORAGE_DRIVER=local
STORAGE_DIR=./storage/uploads
# Com STORAGE_DRIVER=s3 (obrigatório na Vercel): bucket PRIVADO compatível com S3
#   Supabase Storage: S3_ENDPOINT=https://<projeto>.supabase.co/storage/v1/s3  S3_REGION=<região>  S3_FORCE_PATH_STYLE=true
#   Cloudflare R2:    S3_ENDPOINT=https://<conta>.r2.cloudflarestorage.com      S3_REGION=auto
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_FORCE_PATH_STYLE=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_MB=25

# Endpoint de lembretes (/api/cron/reminders). Chamado por um agendador externo.
CRON_SECRET=

# ---------------- Integrações (opcionais) ----------------
# Sem estas variáveis as notificações ficam registradas como "não enviadas".

# E-mail transacional via Resend (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM="DS Hidráulica <agendamento@seudominio.com.br>"
# E-mail que recebe avisos de novas solicitações
ADMIN_NOTIFY_EMAIL=

# WhatsApp Business Platform (Cloud API oficial da Meta)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número (com DDI) que recebe avisos de novas solicitações
WHATSAPP_ADMIN_NUMBER=
# Templates aprovados na Meta (mensagens iniciadas pela empresa exigem template)
WHATSAPP_TEMPLATE_LANG=pt_BR
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_STATUS=
WHATSAPP_TEMPLATE_ADMIN_ALERT=

# ---------------- Experiência 3D (opcional) ----------------
# Modelos GLB profissionais. Veja docs/MODELOS-3D.md para a convenção de nomes.
NEXT_PUBLIC_HERO_TRUCK_MODEL=
NEXT_PUBLIC_HERO_GEAR_MODEL=
# Pasta com a sequência de imagens pré-renderizada (dispositivos simples)
NEXT_PUBLIC_HERO_SEQUENCE_DIR=/hero/sequence
